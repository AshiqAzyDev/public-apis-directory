{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.api-directory/schema.json",
  "title": "Public APIs Directory — API record",
  "type": "object",
  "required": [
    "id",
    "name",
    "slug",
    "description",
    "category",
    "documentation_url",
    "source",
    "auth",
    "https",
    "cors",
    "verification_status"
  ],
  "additionalProperties": true,
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "slug": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "category": { "type": "string", "minLength": 1 },
    "tags": {
      "type": "array",
      "items": { "type": "string" }
    },
    "secondary_categories": {
      "type": "array",
      "items": { "type": "string" }
    },
    "source": { "const": "public-apis" },
    "documentation_url": { "$ref": "#/$defs/field" },
    "documentation_url_original": { "type": "string" },
    "canonical_url": { "type": "string" },
    "provider_domain": { "type": "string" },
    "website_url": { "$ref": "#/$defs/field" },
    "auth": { "$ref": "#/$defs/field" },
    "auth_location": { "$ref": "#/$defs/field" },
    "https": { "$ref": "#/$defs/field" },
    "cors": { "$ref": "#/$defs/field" },
    "browser_ready": { "$ref": "#/$defs/field" },
    "server_side_recommended": { "$ref": "#/$defs/field" },
    "free_access": { "$ref": "#/$defs/field" },
    "pricing_model": { "$ref": "#/$defs/field" },
    "api_type": { "$ref": "#/$defs/field" },
    "data_formats": { "$ref": "#/$defs/field" },
    "sdk_languages": { "$ref": "#/$defs/field" },
    "openapi_available": { "$ref": "#/$defs/nullableField" },
    "openapi_url": { "$ref": "#/$defs/nullableField" },
    "postman_available": { "$ref": "#/$defs/nullableField" },
    "postman_url": { "$ref": "#/$defs/nullableField" },
    "rate_limit": { "$ref": "#/$defs/field" },
    "commercial_use": { "$ref": "#/$defs/field" },
    "registration_required": { "$ref": "#/$defs/field" },
    "verification_status": {
      "type": "string",
      "enum": [
        "Verified",
        "Partially Verified",
        "Upstream Only",
        "Needs Review",
        "Dead",
        "Unknown"
      ]
    },
    "confidence": {
      "type": "string",
      "enum": ["High", "Medium", "Low", "Unknown"]
    },
    "lifecycle_status": {
      "type": "string",
      "enum": [
        "Active",
        "Possibly Active",
        "Needs Verification",
        "Inactive",
        "Dead",
        "Unknown"
      ]
    },
    "last_verified": { "type": ["string", "null"] },
    "verification_source": { "type": "string" },
    "needs_review": { "type": "boolean" },
    "notes": { "type": "string" },
    "developer_score": { "$ref": "#/$defs/score" },
    "health_score": { "$ref": "#/$defs/score" }
  },
  "$defs": {
    "sourceType": {
      "type": "string",
      "enum": [
        "public-apis",
        "provider_documentation",
        "derived",
        "unknown",
        "link-check"
      ]
    },
    "field": {
      "type": "object",
      "required": ["value", "source_type"],
      "properties": {
        "value": true,
        "source_type": { "$ref": "#/$defs/sourceType" },
        "source_url": { "type": ["string", "null"] },
        "verified_at": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "nullableField": {
      "type": "object",
      "required": ["value", "source_type"],
      "properties": {
        "value": { "type": ["string", "boolean", "null"] },
        "source_type": { "$ref": "#/$defs/sourceType" },
        "source_url": { "type": ["string", "null"] },
        "verified_at": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "score": {
      "type": "object",
      "required": ["value", "max", "source_type"],
      "properties": {
        "value": { "type": ["number", "null"] },
        "max": { "type": "number" },
        "breakdown": { "type": "object" },
        "source_type": { "$ref": "#/$defs/sourceType" },
        "label": { "type": "string" }
      }
    }
  }
}
